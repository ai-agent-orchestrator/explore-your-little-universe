    "N"]},
    {code: "INTJ", traits: ["I",
    "T",
    "J",
    "N"]},
    {code: "INTP", traits: ["I",
    "T",
    "P",
    "N"]},
    {code: "ISFJ", traits: ["I",
    "S",
    "J",
    "F"]},
    {code: "ISFP", traits: ["I",
    "S",
    "P",
    "F"]},
    {code: "ISTJ", traits: ["I",
    "S",
    "T",
    "J"]},
    {code: "ISTP", traits: ["I",
    "S",
    "T",
    "P"]}] AS row
    MERGE (m:MbtiType {code: row.code}) SET m.name=row.code
    WITH row, m UNWIND row.traits AS key
    MATCH (t:SharedTrait {key:key}) MERGE (m)-[:HAS_TRAIT]->(t)
    RETURN count(*) AS imported_types
}
CALL () {
    UNWIND [{id: "aquarius", name: "물병자리", traits: ["T",
    "N"]},
    {id: "aries", name: "양자리", traits: ["P",
    "E"]},
    {id: "cancer", name: "게자리", traits: ["I",
    "F"]},
    {id: "capricorn", name: "염소자리", traits: ["S",
    "J"]},
    {id: "gemini", name: "쌍둥이자리", traits: ["N",
    "E"]},
    {id: "leo", name: "사자자리", traits: ["F",
    "E"]},
    {id: "libra", name: "천칭자리", traits: ["P",
    "F"]},
    {id: "pisces", name: "물고기자리", traits: ["F",
    "N"]},
    {id: "sagittarius", name: "사수자리", traits: ["P",
    "N"]},
    {id: "scorpio", name: "전갈자리", traits: ["I",
    "T"]},
    {id: "taurus", name: "황소자리", traits: ["S",
    "J"]},
    {id: "virgo", name: "처녀자리", traits: ["T",
    "J"]}] AS row
    MERGE (z:ZodiacSign {id:row.id}) SET z.name=row.name, z.is_demo=true
    WITH row, z UNWIND row.traits AS key
    MATCH (t:SharedTrait {key:key}) MERGE (z)-[:HAS_TRAIT]->(t)
    RETURN count(*) AS imported_signs
}
