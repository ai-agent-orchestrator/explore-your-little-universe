// Lumi editorial learning graph. Source-informed paraphrases and original fictional applications.
// No password, model, embedding vectors, APOC or Python required.
// Select your own learning database in Neo4j Browser, paste this ENTIRE file, then Run.
// Does not delete data. Sequential re-runs reuse stable IDs; use a dedicated lab database.
CALL () {
    UNWIND [{id: "I", title: "혼자 충전"},
    {id: "E", title: "함께 충전"},
    {id: "S", title: "구체적인 관찰"},
    {id: "N", title: "가능성 탐색"},
    {id: "T", title: "이유 살피기"},
    {id: "F", title: "마음 살피기"},
    {id: "J", title: "계획의 편안함"},
    {id: "P", title: "유연한 선택"}] AS row
    MERGE (t:SharedTrait:MbtiTrait {key: row.id})
    SET t.title=row.title, t.name=row.title
    RETURN count(*) AS imported_traits
}
