    {id: "zodiac-virgo-07", title: "처녀자리 · 배움", text: "처녀자리: 실수 기록을 남기되 다음에 바꿀 한 가지만 골라보자. 공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시.", category: "별자리 · 배움", document_id: "profile-zodiac-virgo", document_title: "처녀자리 해설과 일상 적용", source: "Astrology.com 공개 별자리 소개(대중 점성술) 참고 · 한국어 재서술 및 직접 작성 예시", traits: ["S",
    "J"], tips: ["record",
    "priority"], kind: "interpretation", subject_kind: "zodiac", subject: "virgo", facet: "배움", source_url: "https://www.astrology.com/zodiac-signs/virgo", reviewed_on: "2026-11-22", editorial_note: "공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시."},
    {id: "zodiac-virgo-08", title: "처녀자리 · 휴식", text: "처녀자리: 쉬는 시간을 더 잘 쉬기 위한 과제로 만들지 않아도 된다. 공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시.", category: "별자리 · 휴식", document_id: "profile-zodiac-virgo", document_title: "처녀자리 해설과 일상 적용", source: "Astrology.com 공개 별자리 소개(대중 점성술) 참고 · 한국어 재서술 및 직접 작성 예시", traits: ["I",
    "F"], tips: ["quiet",
    "selfkind"], kind: "interpretation", subject_kind: "zodiac", subject: "virgo", facet: "휴식", source_url: "https://www.astrology.com/zodiac-signs/virgo", reviewed_on: "2026-11-22", editorial_note: "공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시."},
    {id: "zodiac-virgo-09", title: "처녀자리 · 선택", text: "처녀자리: 완벽한 후보 대신 오늘의 필수 조건을 만족하는지 확인해보자. 공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시.", category: "별자리 · 선택", document_id: "profile-zodiac-virgo", document_title: "처녀자리 해설과 일상 적용", source: "Astrology.com 공개 별자리 소개(대중 점성술) 참고 · 한국어 재서술 및 직접 작성 예시", traits: ["T",
    "P"], tips: ["criteria",
    "flexible"], kind: "interpretation", subject_kind: "zodiac", subject: "virgo", facet: "선택", source_url: "https://www.astrology.com/zodiac-signs/virgo", reviewed_on: "2026-11-22", editorial_note: "공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시."},
    {id: "zodiac-virgo-10", title: "처녀자리 · 작은 성장", text: "처녀자리: 초안을 보여줄 시간을 정하고 작은 피드백을 받아보자. 공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시.", category: "별자리 · 작은 성장", document_id: "profile-zodiac-virgo", document_title: "처녀자리 해설과 일상 적용", source: "Astrology.com 공개 별자리 소개(대중 점성술) 참고 · 한국어 재서술 및 직접 작성 예시", traits: ["J",
    "E"], tips: ["share",
    "plan"], kind: "interpretation", subject_kind: "zodiac", subject: "virgo", facet: "작은 성장", source_url: "https://www.astrology.com/zodiac-signs/virgo", reviewed_on: "2026-11-22", editorial_note: "공개 해설의 주제에서 착안해 직접 쓴 일상 적용 예시."}] AS row
    MERGE (d:RagDocument {id:row.document_id})
    SET d.title=row.document_title, d.name=row.document_title, d.source=row.source, d.is_demo=true,
        d.source_url=row.source_url, d.reviewed_on=row.reviewed_on
    MERGE (c:RagChunk {id:row.id})
    SET c.title=row.title, c.name=row.title, c.text=row.text, c.category=row.category,
        c.kind=row.kind, c.subject_kind=row.subject_kind, c.subject=row.subject,
        c.facet=row.facet, c.source_url=row.source_url, c.reviewed_on=row.reviewed_on,
        c.editorial_note=row.editorial_note
    MERGE (c)-[:FROM_DOCUMENT]->(d)
    WITH row, c UNWIND row.traits AS key
    MATCH (t:SharedTrait {key:key}) MERGE (t)-[:FROM_CHUNK]->(c)
    RETURN count(*) AS imported_chunks
}
CALL () {
    UNWIND [{id: "quiet", trait: "I", text: "약속 사이에 혼자 쉬는 시간을 하나 남겨보세요."},
    {id: "small", trait: "I", text: "큰 모임 대신 편한 한 사람과 짧게 만나보세요."},
    {id: "share", trait: "E", text: "생각을 정리할 때 편한 사람에게 먼저 말해보세요."},
    {id: "invite", trait: "E", text: "부담 없는 짧은 만남을 직접 제안해보세요."},
    {id: "facts", trait: "S", text: "지금 확인할 수 있는 사실 세 가지를 적어보세요."},
    {id: "step", trait: "S", text: "막연한 목표를 오늘 할 수 있는 한 단계로 나눠보세요."},
    {id: "idea", trait: "N", text: "가능한 선택을 세 개 적고 하나만 작게 시도해보세요."},
    {id: "meaning", trait: "N", text: "이번 선택에서 내가 기대하는 경험을 한 줄 적어보세요."},
    {id: "reason", trait: "T", text: "내가 중요하게 생각하는 기준을 짧게 설명해보세요."},
    {id: "boundary", trait: "T", text: "가능한 것과 어려운 것을 구체적으로 나눠 말해보세요."},
    {id: "feeling", trait: "F", text: "상대의 기분을 묻고 내 바람도 함께 말해보세요."},
    {id: "kind", trait: "F", text: "거절할 때 고마운 마음과 가능한 대안을 같이 전해보세요."},
    {id: "plan", trait: "J", text: "만나는 시간과 귀가 시간만 먼저 정해보세요."},
    {id: "buffer", trait: "J", text: "일정에 변경 가능한 여유 시간을 남겨보세요."},
    {id: "try", trait: "P", text: "전체를 결정하기 전에 작은 선택 하나를 먼저 해보세요."},
    {id: "pause", trait: "I", text: "바로 답하기 전에 조용히 생각할 시간을 요청해보세요."},
    {id: "hello", trait: "E", text: "함께해보고 싶은 사람에게 짧은 안부 한 줄을 보내보세요."},
    {id: "record", trait: "S", text: "오늘 실제로 해낸 일 하나를 구체적인 문장으로 남겨보세요."},
    {id: "imagine", trait: "N", text: "정답 대신 다른 관점 두 개를 떠올려 적어보세요."},
    {id: "criteria", trait: "T", text: "선택 기준 두 개만 정하고 각각의 장단점을 비교해보세요."},
    {id: "selfkind", trait: "F", text: "친한 친구에게 해줄 다정한 말을 나에게도 한 줄 적어보세요."},
    {id: "priority", trait: "J", text: "오늘 꼭 할 일 하나를 정하고 나머지는 다음 순서로 남겨보세요."},
    {id: "flexible", trait: "P", text: "지금 정할 것 하나와 나중에 바꿀 수 있는 것 하나를 나눠보세요."},
    {id: "sample", trait: "P", text: "오래 약속하기 전에 10분짜리 체험부터 제안해보세요."}] AS row
    MERGE (i:RagTip {id:row.id}) SET i.text=row.text, i.name=row.text
    WITH row, i MATCH (t:SharedTrait {key:row.trait}) MERGE (t)-[:SUGGESTS]->(i)
    RETURN count(*) AS imported_suggestions
}
